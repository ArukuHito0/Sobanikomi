# 環境変数（APIキーやDB接続情報など絶対コミットNG）
.env
.env.local
.env.*.local

# Node.js パッケージ（容量が大きく自動生成されるため不要）
node_modules/

# ログファイル
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 開発用の一時ファイルやログ
*.log

# OS固有の不要ファイル
.DS_Store
Thumbs.db

#テスト用のアップロード不要のファイル
singletest
ComplessedTweetData

# エディタ・IDEの固有設定
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

